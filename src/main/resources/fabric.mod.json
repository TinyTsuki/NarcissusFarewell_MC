{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_desc}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "xin.vanilla.narcissus.internal.fabric.FabricNarcissusEntry"
    ],
    "client": [
      "xin.vanilla.narcissus.internal.fabric.client.FabricNarcissusClientEntry"
    ],
    "modmenu": [
      "xin.vanilla.narcissus.internal.fabric.modmenu.NarcissusModMenuIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "banira_codex": "${banira_version_range}"
  }
}
